# Flask Environment
FLASK_ENV=development
SECRET_KEY=your-secret-key-at-least-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-chars

# Database URL
# PostgreSQL (default):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_clubs
# SQLite alternative for local quick-testing:
# DATABASE_URL=sqlite:///the_clubs.db

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
